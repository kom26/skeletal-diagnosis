# ============================================================
# 骨格診断AI - 環境変数テンプレート
# このファイルを .env.local にコピーして値を埋めてください
# .env.local は絶対に Git にコミットしないこと！
# ============================================================

# --- Supabase ---
# Supabase Dashboard > Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Anthropic API (画像分析用) ---
# https://console.anthropic.com/ から取得
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- コスト制御設定 ---
# 1日あたりの診断上限回数（デフォルト: 100）
DAILY_LIMIT=100
# 同一IPによる1時間あたりの上限回数（デフォルト: 5）
IP_HOURLY_LIMIT=5

# --- 管理者ページ認証 ---
# 任意の強力なパスワードを設定してください
ADMIN_SECRET_KEY=your-super-secret-admin-key-change-this

# --- (本番環境のみ) アプリのURL ---
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
